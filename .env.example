# OngoleProperty.com environment template
# Copy to .env.local for local development. Never commit .env.local or real
# server-side credentials. Values marked TODO must come from the named provider.

# ---------------------------------------------------------------------------
# Core application
# ---------------------------------------------------------------------------

# Required in production. Use http://localhost:3000 for local development.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Required for live database/authentication features and `pnpm verify:supabase`.
# Local development remains available in demo-data mode when both are blank.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Required in production for scheduled jobs and server-only payment/order work.
# TODO: Copy from Supabase Project Settings > API. Never expose this value using
# a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

# Required in production because vercel.json enables the maintenance cron.
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=

# ---------------------------------------------------------------------------
# Public site links and feature switches (optional)
# ---------------------------------------------------------------------------

NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_LINKEDIN_URL=

# Public UI switches. These defaults match current application behavior.
NEXT_PUBLIC_FEATURE_MEMBERSHIPS=false
NEXT_PUBLIC_FEATURE_BLOG=true
NEXT_PUBLIC_FEATURE_AGENTS=true
NEXT_PUBLIC_FEATURE_PG=true

# ---------------------------------------------------------------------------
# Cloudflare Turnstile (optional; both values must be configured together)
# ---------------------------------------------------------------------------

NEXT_PUBLIC_CAPTCHA_SITE_KEY=
CAPTCHA_SECRET_KEY=

# ---------------------------------------------------------------------------
# Email delivery (optional; absent values keep the safe queue/log fallback)
# ---------------------------------------------------------------------------

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# Optional recipient for administrator enquiry notifications.
ADMIN_NOTIFICATION_EMAIL=

# ---------------------------------------------------------------------------
# Distributed rate limiting (optional; both values must be configured together)
# ---------------------------------------------------------------------------

# Upstash-compatible HTTPS REST endpoint and token, not a redis:// TCP URL.
REDIS_URL=
REDIS_TOKEN=

# ---------------------------------------------------------------------------
# Maps, analytics, monitoring, and search ownership (optional)
# ---------------------------------------------------------------------------

# Browser map embeds use NEXT_PUBLIC_GOOGLE_MAPS_API_KEY. Restrict the key by
# HTTP referrer and to the Google Maps Embed API.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

NEXT_PUBLIC_GA_MEASUREMENT_ID=
SENTRY_DSN=
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# ---------------------------------------------------------------------------
# Razorpay online payments (optional; all three values are required together)
# ---------------------------------------------------------------------------

# Keep secrets server-only. RAZORPAY_KEY_ID is returned by the protected order
# API only when checkout is enabled.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Verification tooling only (optional)
# ---------------------------------------------------------------------------

# Disposable non-production accounts used only by `pnpm verify:auth`.
AUTH_TEST_USER_EMAIL=
AUTH_TEST_USER_PASSWORD=
AUTH_TEST_ADMIN_EMAIL=
AUTH_TEST_ADMIN_PASSWORD=

# Absolute path to @electric-sql/pglite's dist/index.js. Used only by the
# standalone Sprint 5 SQL validators.
PGLITE_MODULE=
